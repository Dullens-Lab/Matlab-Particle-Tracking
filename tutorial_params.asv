COORD = struct ;
particles   = [] ;
pks         = [] ;

pxum        = 7.25 ; % Microscope calibartion, pixels per micrometre [ /um ]
pxum        = pxum * 1e-6 ; % pixels per metre [ /m ]

excl_dia    = 25 ;  % Diameter, in pixels, where only one peak pixel will be recorded
backgrnd    = 110 ; % Background threshold
maxdisp     = 30 ;  % Estimated maximum displacement a colloid may undergoe between frames

param.mem   = 40 ;  % Number of frames to keep a lost particle in the memoroy
param.good  = 200 ; % At the end of track(), colloids with centroids < param.good are discarded 
param.dim   = 2 ;
param.quiet = 0 ;

excl_rad    = floor( excl_dia / 2 ) ;