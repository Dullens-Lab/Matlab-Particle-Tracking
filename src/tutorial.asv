%
% Particle Tracking Tutorial
%
% Origanal: https://site.physics.georgetown.edu/matlab/tutorial.html
%
%

clearvars ;

addpath(genpath('../')) % Add all Matlab Particle Tracking sub directories

tutorial_params % Load our paramameters

parfor frame = 1 : 1200
    
    % Load current image
    image_array = double( imread( [ 'tests/demo_data/' num2str( frame ) '.tiff' ] ) ) ;
    
    % Filter the image
    filtered_image = bpass( image_array, false, true, backgrnd, false ) ;
    
    % Find the peak pixels
    est_pks = pkfnd( filtered_image, backgrnd, excl_dia ) ;
    pks = [ pks ; est_pks ] ;
    
    % Calculate the sub pixel centroids
    cntrds = cntrd( filtered_image, est_pks, excl_dia, true, frame ) ;
    
    % Collect the result
    particles = [ particles ; cntrds ] ;
    COORD( frame ).cntrds = cntrds ;

end

tracks = track( particles( :, [ 1 2 5 ] ), maxdisp, param ) ;

tracks( :, [ 1 2 ] ) = tracks( :, [ 1 2 ] ) / pxum ;

[ msd, tau, msd_count ] = calcMSD( tracks ) ;

% Plot particle brightness vs size.
figure ; plot( particles(:,4), particles(:,3), 'o')
xlabel('Estimated Sizes');
ylabel('Peak Brightness');

% Plot X nad Y
figure ; plot(tracks(:,1),tracks(:,2),'.')
xlabel('x (\mum)');
ylabel('y (\mum)');

figure ; plot( tau, msd, 'o' )
xlabel('Lag time, \tau, (s)');
ylabel('\langle \Deltar( \tau )^2 \rangle (m^2)');

D_t = (1.38e-23 * 298) / (6 * pi * 1.0e-3 * 5e-7 ) ;
